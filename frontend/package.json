    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "^6.0.5",
    "prettier": "^3.3.3",
    "typescript": "5.6.3",
    "vite": "^8.3.4"
  }
}
