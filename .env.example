APP_ENV=development

# Host-side URLs used by Alembic, scripts, and tests.
APP_DATABASE_URL=postgresql+asyncpg://app_user:CHANGE_ME@localhost:5433/app_db
TARGET_DATABASE_URL=postgresql://plan_proof_reader:CHANGE_ME@localhost:5433/target_db
SANDBOX_DATABASE_URL=postgresql://sandbox_admin:CHANGE_ME@localhost:5434/sandbox_db

# Compose and first-time database initialization credentials.
TARGET_ADMIN_PASSWORD=CHANGE_ME
APP_DB_USER=app_user
APP_DB_PASSWORD=CHANGE_ME
TARGET_READER_USER=plan_proof_reader
TARGET_READER_PASSWORD=CHANGE_ME
SANDBOX_USER=sandbox_admin
SANDBOX_PASSWORD=CHANGE_ME

REDIS_URL=redis://localhost:6379/0
WEB_PORT=3001

# Optional index proposal provider. Leave the key blank to use heuristics only.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# For another OpenAI-compatible endpoint, set LLM_PROVIDER=openai_compatible,
# LLM_MODEL, LLM_API_KEY, and (if needed) LLM_BASE_URL.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
